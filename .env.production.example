# Production-like environment contract (Phase 17). Copy this file to
# `.env.production` and fill in real values — never commit that file.
# Used both as Compose's `--env-file` (interpolates ${VAR} references in
# docker-compose.prod.yml) and as each app container's `env_file:` — see
# that file's header comment.
#
# Every value below is a placeholder or a safe local-only example. No real
# secret, hostname, or credential belongs in this file.

# ---------------------------------------------------------------------------
# REQUIRED — no safe default outside DEBUG; the app/settings module refuses
# to boot without a real value (see config/settings.py's fail-fast checks).
# ---------------------------------------------------------------------------

# Django signing key. Generate a real one per deployment, e.g.:
#   python -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=CHANGE_ME_TO_A_REAL_SECRET_KEY

DEBUG=False

# Comma-separated host allowlist — no wildcard supported or safe.
ALLOWED_HOSTS=example.com,www.example.com

# PostgreSQL (pgvector-enabled) connection string. Host is the Compose
# service name (`db`), not `localhost`, inside this topology. Password
# here must match POSTGRES_PASSWORD below — the `db` service and the app
# services both read from this same file but do not derive one from the
# other.
DATABASE_URL=postgres://postgres:CHANGE_ME_DB_PASSWORD@db:5432/supportpilot

# Celery broker + result backend.
REDIS_URL=redis://redis:6379/0
# Django cache backend — distinct logical Redis DB from REDIS_URL.
CACHE_URL=redis://redis:6379/1

# Explicit origin allowlists — no wildcard supported or safe.
CORS_ALLOWED_ORIGINS=https://app.example.com
CSRF_TRUSTED_ORIGINS=https://app.example.com

# Symmetric key(s) encrypting stored integration/channel credentials at
# rest. Comma-separated for rotation (first key encrypts new values, all
# are tried on decrypt). Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
INTEGRATIONS_CREDENTIAL_ENCRYPTION_KEYS=CHANGE_ME_TO_A_REAL_FERNET_KEY

# Required only once /metrics/ is enabled outside DEBUG (see
# OBSERVABILITY_METRICS_ENABLED below) — the app refuses to boot with
# metrics on and no token set outside DEBUG.
OBSERVABILITY_METRICS_TOKEN=CHANGE_ME_TO_A_REAL_BEARER_TOKEN

# PostgreSQL container's own credentials (the `db` service reads these
# directly; keep the password in sync with DATABASE_URL above).
POSTGRES_USER=postgres
POSTGRES_PASSWORD=CHANGE_ME_DB_PASSWORD
POSTGRES_DB=supportpilot

# ---------------------------------------------------------------------------
# OPTIONAL WITH SAFE DEFAULT — the app boots and degrades safely without
# these; shown here with their real default or a representative override.
# ---------------------------------------------------------------------------

# Trusted reverse-proxy depth for DRF throttle client identity. Default 0
# (no reverse proxy trusted — forwarded-address headers are ignored,
# identity is always the direct peer). Only raise this to the exact
# number of trusted, header-sanitizing reverse proxies actually in front
# of this deployment.
DRF_NUM_PROXIES=0

# Explicit HTTP->HTTPS redirect override. Default (unset): True outside
# DEBUG. Set False only if TLS terminates at a reverse proxy/load balancer
# in front of this deployment and plain HTTP is forwarded internally.
SECURE_SSL_REDIRECT=True

AUTH_REFRESH_COOKIE_NAME=sp_refresh_token
# Forced true automatically outside DEBUG regardless of this value.
AUTH_REFRESH_COOKIE_SECURE=True
AUTH_REFRESH_COOKIE_SAMESITE=Lax

# Web process (Gunicorn) — conservative defaults, never derived from a
# build/dev-host CPU count. See config/gunicorn_conf.py.
WEB_CONCURRENCY=3
WEB_TIMEOUT_SECONDS=30
WEB_GRACEFUL_TIMEOUT_SECONDS=30
WEB_KEEPALIVE_SECONDS=5
# Host port docker-compose.prod.yml's `web` service publishes.
WEB_PORT=8000

# Celery worker concurrency — conservative default, independently
# configurable from Gunicorn's WEB_CONCURRENCY above.
CELERY_WORKER_CONCURRENCY=2

# Built image tag docker-compose.prod.yml resolves `image:` to.
IMAGE_TAG=latest

# Stuck-worker recovery (Phase 16/17) — staleness threshold (how old a
# RUNNING row must be before recovery) is deliberately independent from
# sweep interval (how often Beat checks); raising either is always safe,
# lowering the *_STALE_SECONDS values below their 1800s floor is refused
# at startup. See agents/recovery.py, evaluations/recovery.py,
# config/celery.py.
AGENTS_STUCK_RUN_STALE_SECONDS=3600
AGENTS_STUCK_RUN_SWEEP_INTERVAL_SECONDS=300
EVALUATIONS_STUCK_RUN_STALE_SECONDS=3600
EVALUATIONS_STUCK_RUN_SWEEP_INTERVAL_SECONDS=300

# Observability — /metrics/ is enabled by default; tracing is off by
# default (no exporter shipped without OBSERVABILITY_OTLP_ENDPOINT).
OBSERVABILITY_METRICS_ENABLED=True
OBSERVABILITY_SERVICE_NAME=supportpilot-backend
OBSERVABILITY_TRACING_ENABLED=False
OBSERVABILITY_OTLP_ENDPOINT=

# ---------------------------------------------------------------------------
# LIVE-PROVIDER OPTIONAL — opt-in only; every normal/CI/demo path uses the
# deterministic offline providers regardless of these. Never required to
# boot.
# ---------------------------------------------------------------------------

# Default "fake" is the deterministic offline LLM provider every normal
# path (including CI) uses. Only set to "openai" with a real key to reach
# a live model.
AGENTS_LLM_PROVIDER=fake
AGENTS_OPENAI_API_KEY=
AGENTS_OPENAI_BASE_URL=

# Gate for real Stripe/Google Calendar/SMTP calls. Off by default — every
# test and the demo seed run entirely against deterministic/fake adapters
# regardless of this flag.
INTEGRATIONS_LIVE_PROVIDERS_ENABLED=False

# Development-only relaxation of outbound webhook URL validation — never
# set True in production.
WEBHOOKS_ALLOW_INSECURE_HTTP=False

# ---------------------------------------------------------------------------
# DEVELOPMENT/DEMO ONLY — not part of the production-like runtime; do not
# set these in a real deployment's .env.production.
# ---------------------------------------------------------------------------

# Required only by `python manage.py seed_demo`; the command refuses to
# run without it and never logs/prints it.
# SUPPORTPILOT_DEMO_PASSWORD=
