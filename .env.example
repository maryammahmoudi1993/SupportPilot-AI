# Copy this file to .env and fill in real values for local development.
# Never commit a real .env file.

# Django
DEBUG=True
AGENTS_CONTEXT_MAX_MESSAGES=20
AGENTS_CONTEXT_MAX_CHARACTERS=12000
AGENTS_RAG_TOP_K=5
AGENTS_RAG_MAX_CHARACTERS=8000
SECRET_KEY=dev-key-change-in-production
ALLOWED_HOSTS=localhost,127.0.0.1

# Database
DATABASE_URL=postgres://postgres:postgres@localhost:5432/supportpilot

# Redis / Celery
REDIS_URL=redis://localhost:6379/0

